# Trust a front proxy (pfSense/HAProxy, another nginx, a cloud LB, ...) so its
# X-Forwarded-For / X-Forwarded-Proto are forwarded (client IP appended)
# instead of replaced with the peer address. DLUX_FRONT_PROXY in .secrets/.env
# names the trusted proxies: unset trusts every private address, a
# space-separated list of addresses or networks (no quotes) trusts only those,
# and an empty value trusts none (users reach Caddy directly). A client Caddy
# does not trust cannot spoof either header. Inert while Caddy terminates TLS
# facing the internet directly; makes client-IP resolution (dlux per-IP
# lockout, audit logs) correct if the stack is ever fronted by a proxy hop.
{
	servers {
		trusted_proxies static {$DLUX_FRONT_PROXY:private_ranges}
	}
}

# ---------------------------------------------------------------------------
# Caddy reverse proxy for the Sales CRM stack.
# dlux stack schema 5
#
# Public and staff paths are split inside Django/DLux, not by Caddy:
#
#   CADDY_SITE_ADDRESS  → Django app (e.g. "crm.example.com www.crm.example.com")
#   CADDY_ERP_ADDRESS   → optional legacy host redirected to /staff/
#
# Automatic HTTPS: when an address is a real hostname (prod), Caddy obtains AND
# renews a Let's Encrypt cert for it on its own — no certbot, no bootstrap. Each
# hostname gets its own cert. HTTP->HTTPS redirect is added automatically.
#
# Local dev (compose.dev.yml): CADDY_SITE_ADDRESS=:80 makes the app the catch-all
# on plain HTTP.
#
# CADDY_MAX_SIZE = max request body (Caddy units, e.g. 10MB).
#
# No ACME email is set: Caddy renews well before expiry, so expiry notices are
# optional. To receive Let's Encrypt expiry emails, add a global block at the top
# with a REAL address (must contain a dot): { email you@your-domain.tld }
# ---------------------------------------------------------------------------

# Full Django app routing, defined once and imported by the site block below.
(erp_app) {
	encode zstd gzip

	request_body {
		max_size {$CADDY_MAX_SIZE:10MB}
	}

	# Ordered routing (route preserves top-to-bottom order, unlike bare directives).
	route {
		# Never serve dlux DB backups over media.
		respond /media/dlux_backups/* 404

		# Static assets — immutable, cached one year. handle_path strips /static.
		handle_path /static/* {
			root * /app/staticfiles
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		# Public media: branding, managed images and fonts, and the project's
		# public/ folder, served to anyone. Keep in step with
		# dlux.files.media.PUBLIC_MEDIA.
		@public_media path /media/public/* /media/dlux/branding/* /media/dlux/assets/image/* /media/dlux/assets/font/*
		handle @public_media {
			uri strip_prefix /media
			root * /app/media
			file_server
		}

		# Live update status/log for the maintenance progress page. Served even
		# during maintenance (Composer writes these on the shared dlux_runtime
		# volume, which stays up while web is recreated).
		handle /_update/status.json {
			root * /opt/dlux-runtime/state
			rewrite * /deploy-status.json
			header Cache-Control "no-store"
			file_server
		}
		handle /_update/log.txt {
			root * /opt/dlux-runtime/state
			rewrite * /deploy-log.txt
			header Cache-Control "no-store"
			file_server
		}

		# Maintenance page assets, published by composer-agent on the runtime
		# volume and served here so they load while web is down.
		handle /_dlux/maintenance/* {
			root * /opt/dlux-runtime/proxy
			uri strip_prefix /_dlux
			header Cache-Control "no-store"
			file_server
		}

		# Always-200 edge-liveness probe for a front proxy's health check. Never
		# proxied to web, never gated by the maintenance flag.
		handle /_edge-alive {
			respond "ok" 200
		}

		# Fetch Metadata resource isolation (web.dev/articles/fetch-metadata):
		# refuse requests another site makes in the background (images, scripts,
		# fetch(), form posts, <object>/<embed>). A link from another site (a
		# top-level GET navigation) still opens a page; same-origin, same-site and
		# typed-in requests pass, and so do requests without the header (crawlers,
		# health checks, server-to-server calls, older browsers). Everything above
		# stays open to other sites on purpose: static files, public media, the
		# update progress files, the maintenance page assets and the edge probe.
		# Composer's fetch-metadata check looks for this matcher by name: keep
		# @cross_site_request.
		@cross_site_request expression <<CEL
			{header.Sec-Fetch-Site} == "cross-site"
			&& !(method("GET", "HEAD")
				&& {header.Sec-Fetch-Mode} == "navigate"
				&& !({header.Sec-Fetch-Dest} in ["object", "embed"]))
			CEL
		respond @cross_site_request 403

		# Every other stored file is private: the app decides who gets it
		# (signed in, and a registered document file only to users who may view
		# its document) before the file server sends a byte. DjangoLux is mounted
		# under /staff/. Storefront images are DLUX_PUBLIC_MEDIA; attachments and
		# receipts are DLUX_APP_ONLY_MEDIA, served by /staff/files/... instead.
		handle /media/* {
			route {
				forward_auth web:8000 {
					uri /staff/sys/files/media-access/
				}
				uri strip_prefix /media
				root * /app/media
				header Cache-Control "private, no-cache"
				file_server
			}
		}

		# Hybrid health endpoint:
		# - normal operation: proxy to Django's /health/
		# - planned maintenance: proxy-local 200 so a front proxy keeps backend UP
		handle /health* {
			@maintenance_health file {
				root /
				try_files /opt/dlux-runtime/state/maintenance
			}
			respond @maintenance_health "ok" 200

			rewrite * /health/
			reverse_proxy web:8000
		}

		# Maintenance flag: dlux writes /opt/dlux-runtime/state/maintenance.
		# Short-circuit the app route to 503 (static/media + /_update/* +
		# /_edge-alive + /health above are already served). handle_errors renders
		# the maintenance progress page.
		@maintenance file {
			root /
			try_files /opt/dlux-runtime/state/maintenance
		}
		error @maintenance 503

		# Primary application.
		reverse_proxy web:8000
	}

	# Maintenance / upstream-down page for a 502, 503 or 504.
	handle_errors {
		@down expression {http.error.status_code} in [502, 503, 504]
		handle @down {
			root * /opt/dlux-runtime/proxy/maintenance
			rewrite * /index.html
			file_server {
				status 503
			}
		}
	}
}

# ── Canonical Django/DLux application (apex + www) ─────────────────────────
{$CADDY_SITE_ADDRESS:localhost} {
	import erp_app
}

# ── Legacy ERP hostname ─────────────────────────────────────────────────────
# Keep old bookmarks working without making Caddy responsible for app routing.
{$CADDY_ERP_ADDRESS:http://erp.localhost} {
	@already_staff path /staff /staff/*
	redir @already_staff {$CADDY_PRIMARY_URL:http://localhost}{uri} permanent
	redir {$CADDY_PRIMARY_URL:http://localhost}/staff{uri} permanent
}
