# dlux stack schema 5
# Sales CRM deployment settings.
# Copy this file to .secrets/.env, replace every CHANGE_ME, then: chmod 600 .secrets/.env
# Generate each secret with: openssl rand -hex 32

# Django
DJANGO_SECRET_KEY=CHANGE_ME
# Password of the `admin` account created on the first start.
ADMIN_PASS=CHANGE_ME

# PostgreSQL. Never change POSTGRES_PASSWORD after the first start.
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME
# Database name (default sales_db). A server whose database has another name keeps
# that name here.
# POSTGRES_DB=sales_db

# Public address. With a real hostname in CADDY_SITE_ADDRESS, Caddy obtains and
# renews Let's Encrypt certificates on its own (ports 80 and 443 must reach it).
BASE_URL=https://CHANGE_ME.example.com
ALLOWED_URLS=https://CHANGE_ME.example.com,https://www.CHANGE_ME.example.com
ALLOWED_HOSTS=CHANGE_ME.example.com,www.CHANGE_ME.example.com,localhost,127.0.0.1,web,caddy,celery
CADDY_SITE_ADDRESS=CHANGE_ME.example.com www.CHANGE_ME.example.com
CADDY_PRIMARY_URL=https://CHANGE_ME.example.com
# Optional legacy hostname redirected to /staff/ (e.g. erp.example.com).
# CADDY_ERP_ADDRESS=
HTTP_PORT=80
HTTPS_PORT=443
# A proxy or TLS terminator in front of Caddy (address or network, space-separated
# for several, no quotes). Unset trusts every private address; empty trusts none.
# Caddy facing the internet directly needs nothing here: `./start.sh check` then
# keeps a front-proxy warning, which is by design.
# DLUX_FRONT_PROXY=10.0.0.5

# Local network or single PC instead (plain HTTP, no certificates):
#   BASE_URL=http://localhost
#   ALLOWED_URLS=http://localhost,http://192.168.1.50
#   ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50,web,caddy,celery
#   CADDY_SITE_ADDRESS=:80
#   CADDY_PRIMARY_URL=http://localhost
#   CADDY_ERP_ADDRESS=http://erp.localhost

# Email. Normally configured in System Settings; these are the fallback.
DEFAULT_FROM_EMAIL=webmaster@localhost
SMTP_RELAY_HOST=smtp.gmail.com
SMTP_RELAY_PORT=587
SMTP_RELAY_USE_TLS=True
SMTP_RELAY_USER=
SMTP_RELAY_PASSWORD=
